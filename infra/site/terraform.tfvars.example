site_bucket_name = "the-fabulous-cube"
root_domain      = "thefabulouscube.com"
site_domain      = "s3-hosted.thefabulouscube.com"

# Both SES identities must be verified before the Lambda can send mail.
contact_to_email   = "you@example.com"
contact_from_email = "verified-sender@example.com"

# Prefer false; browser-visible API keys are not secrets.
contact_api_key_enabled = false
